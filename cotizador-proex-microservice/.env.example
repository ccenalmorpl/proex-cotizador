# AWS Lambda Configuration
AWS_REGION=eu-west-1
LAMBDA_FUNCTION_NAME=cotizador-proex
AWS_ACCOUNT_ID=your-aws-account-id
ECR_REPO_NAME=cotizador-proex
FUNCTION_NAME=cotizador-proex

# HubSpot
PROEX_ACCESS_TOKEN=pat-eu1-your-token-here

# Secreto de la card (endpoints de negocio, NO los webhooks de HubSpot Workflow)
# La card lo manda en el header Authorization: "Bearer <secreto>", porque
# hubspot.fetch() descarta cualquier otro header custom. Solo se exige si DEBUG=False;
# si falta en producción, los endpoints de negocio responden 503.
PROEX_CARD_SECRET=PROEX_CARD_SECRET

# CORS
CORS_ORIGINS=http://localhost:3000,https://app.hubspot.com,https://app-eu1.hubspot.com

# App Configuration
DEBUG=False
APP_NAME="Cotizador Proex Microservice"
VERSION=1.0.0

# Server Configuration (for local development)
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
